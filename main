from nltk.corpus import words
import random
import pygame as pg

pg.init()
(width, height) = (800, 600)
screen = pg.display.set_mode((width, height))
pg.display.set_caption("Word Sandwich")

white = (255, 255, 255)
red = (255, 0, 0)
orange = (255, 125, 0)
lime = (100, 255, 0)
green = (0, 255, 0)
aqua = (0, 230, 255)

base_font = pg.font.Font(None, 50)
heading_font = pg.font.Font(None,75)
prompt_font = pg.font.Font(None,150)

heading = heading_font.render("Word Sandwich", True, orange)
input_req = base_font.render("Enter an answer:", True, white)

input_box = pg.Rect(100, 500, 600, 50)
input_inactive = pg.Color('lightskyblue3')
input_active = pg.Color('silver')
input_color = input_inactive
active = False

letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
start_letters_by_difficulty = "SCBTPADFHWMEIORGLNUYJKQVXZ"
end_letters_by_difficulty = "EYRSTNDFGLOAHMKIWPUCXZB"

valid_words = set(words.words())
answer = ""
result = base_font.render("", True, green)
answer_submitted = False

score = 0
round = 1
difficulty = 0

random_first = random.choice(start_letters_by_difficulty[random.randint(0,2)])
random_last = random.choice(end_letters_by_difficulty[random.randint(0,2)])

running = True

while running:

    for event in pg.event.get():
        if event.type == pg.QUIT:
            running = False
        if event.type == pg.MOUSEBUTTONDOWN:
                if input_box.collidepoint(event.pos):
                    active = not active
                else:
                    active = False
                input_color = input_active if active else input_inactive
        if event.type == pg.KEYDOWN:
            if active:
                if event.key == pg.K_RETURN:
                    answer_submitted = True
                elif event.key == pg.K_BACKSPACE:
                    answer = answer[:-1]
                else:
                    if event.unicode in letters:
                        answer += event.unicode

    prompt = prompt_font.render(f"{random_first}" + " _____ " + f"{random_last}", True, white)
    input_display = base_font.render(answer, True, input_color)

    if answer_submitted:
        if answer.lower() not in valid_words:
            result = base_font.render("                  Invalid word!                  ", True, red)
        elif answer[0].lower() != random_first.lower() or answer[-1].lower() != random_last.lower():
            result = base_font.render("Word does not match the letters!", True, red)
        else:
            result = base_font.render(f"***** Correct! {len(answer)} letter bonus *****", True, green)
            score += 5*len(answer)
            round += 1
            if difficulty < 21 and (score % 10 == 0 or random.randint(0,2) == 0):
                difficulty += 1
            random_first = random.choice(start_letters_by_difficulty[difficulty+random.randint(0,4)])
            random_last = random.choice(end_letters_by_difficulty[difficulty+random.randint(0,1)])
        answer_submitted = False
        answer = ""
    
    round_display = base_font.render(f"Round {round}", True, lime)
    score_display = base_font.render(f"{score}", True, aqua)

    background_colour = (difficulty*12, 180-(difficulty*8), 255-(difficulty*12))

    screen.fill(background_colour)
    screen.blit(heading, (200,20))
    screen.blit(round_display, (20,30))
    screen.blit(score_display, (700,30))
    screen.blit(prompt, (150, 200))
    screen.blit(input_req, (250, 450))
    pg.draw.rect(screen, input_color, input_box, 5)
    screen.blit(input_display, (input_box.x+5, input_box.y+12))
    screen.blit(result, (125, 325))
    pg.display.flip()

